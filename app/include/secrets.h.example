#ifndef SECRETS_H
#define SECRETS_H

#include "wifi_creds.h"

/*
 * Copy this file to secrets.h and fill in real credentials.
 * secrets.h is gitignored — never commit real passwords.
 */
static const struct wifi_network known_networks[] = {
	{
		.ssid = "YourSSID",
		.password = "YourPassword",
		.security = WIFI_SECURITY_TYPE_PSK,
	},
};

#define KNOWN_NETWORKS_COUNT (sizeof(known_networks) / sizeof(known_networks[0]))

#endif /* SECRETS_H */
